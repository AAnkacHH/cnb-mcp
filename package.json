{
  "name": "cnb-mcp",
  "version": "1.0.0",
  "description": "MCP server for Czech National Bank (ČNB) public API",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cnb-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cnb",
    "czech-national-bank",
    "exchange-rates",
    "currency",
    "finance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AAnkacHH/cnb-mcp.git"
  },
  "homepage": "https://github.com/AAnkacHH/cnb-mcp#readme",
  "author": "Andrii Plyskach",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
